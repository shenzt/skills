{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny"
  },
  "agent": {
    "council-participant": {
      "description": "Answer one supplied model-council question directly without tools, subagents, or workspace access.",
      "mode": "primary",
      "permission": {
        "*": "deny"
      }
    }
  },
  "provider": {
    "google": {
      "models": {
        "gemini-3.7-flash": {
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "alibaba-cn": {
      "models": {
        "kimi/kimi-k3": {
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "qwen3.8-max": {
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    },
    "zhipuai": {
      "models": {
        "glm-5.3": {
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  }
}
